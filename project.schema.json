{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Worktree project",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "workdir", "bare_repositories_dir_path", "original_repositories_dir_path", "repositories"],
  "properties": {
    "project": { "type": "string", "minLength": 1 },
    "workdir": { "type": "string", "minLength": 1, "description": "Path relative to the project folder." },
    "bare_repositories_dir_path": { "type": "string", "minLength": 1 },
    "original_repositories_dir_path": { "type": "string", "minLength": 1 },
    "repositories": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "url", "main_branch_name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "main_branch_name": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
